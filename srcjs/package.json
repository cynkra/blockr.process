{
  "name": "blockr-process-srcjs",
  "version": "0.0.1",
  "private": true,
  "description": "JS bundle sources for the blockr.process BPMN widget",
  "scripts": {
    "build": "esbuild index.js --bundle --format=iife --global-name=BlockrBpmn --minify --outfile=../inst/htmlwidgets/lib/bpmn/bpmn-bundle.js && esbuild layout-cli.js --bundle --format=esm --platform=node --outfile=../inst/node/layout-cli.mjs"
  },
  "dependencies": {
    "bpmn-auto-layout": "^1.3.0",
    "bpmn-visualization": "^0.48.0"
  },
